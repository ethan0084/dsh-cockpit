{
  "name": "ethan-workbench",
  "version": "0.1.0",
  "description": "A desktop-style project and AI workbench for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "workbench"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan0084/ethan-workbench.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/ethan0084/ethan-workbench#readme",
  "bugs": {
    "url": "https://github.com/ethan0084/ethan-workbench/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ethan-workbench-layout": "workspace:0.1.0",
    "ethan-workbench-ui": "workspace:0.1.0"
  }
}
