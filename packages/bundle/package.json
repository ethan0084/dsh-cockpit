{
  "name": "dsh-cockpit",
  "version": "0.2.2",
  "description": "A desktop-style project and AI workbench for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "workbench"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan0084/dsh-cockpit.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/ethan0084/dsh-cockpit#readme",
  "bugs": {
    "url": "https://github.com/ethan0084/dsh-cockpit/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "prepack": "node ../../scripts/build-bundle.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./layout": "./embedded/layout/index.js",
    "./layout/package.json": "./embedded/layout/package.json",
    "./ui": "./embedded/ui/index.js",
    "./ui/package.json": "./embedded/ui/package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "embedded",
    "vendor",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "mammoth": "^1.10.0"
  }
}
